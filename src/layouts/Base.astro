---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { u } from '../lib/url';
import { ClientRouter } from 'astro:transitions';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import textFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

interface Props {
  title: string; description: string; image?: string; headerTone?: 'light' | 'dark';
  jsonld?: Record<string, unknown>[]; breadcrumbs?: { name: string; path: string }[]; noindex?: boolean; preload?: string[];
}
const { title, description, image = '/og/default.jpg', headerTone = 'light', jsonld = [], breadcrumbs, noindex = false, preload = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes('PropBillions') ? title : `${title} | PropBillions`;
const ogImage = new URL(u(image), Astro.site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'RealEstateAgent', '@id': new URL(u('/#org'), Astro.site).href,
  name: site.name, url: new URL(u('/'), Astro.site).href, logo: new URL(u('/favicon.svg'), Astro.site).href,
  ...(site.phone ? { telephone: site.phone } : {}), ...(site.email ? { email: site.email } : {}),
  ...(site.address ? { address: site.address } : {}),
};
const crumbs = breadcrumbs && {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(u(b.path), Astro.site).href })),
};
const ld = [org, ...(crumbs ? [crumbs] : []), ...jsonld];
// Page turn: the old page sinks and fades, the new one rises in. Short enough never to feel like waiting.
const pageTurn = {
  forwards: { old: { name: 'pbOut', duration: '0.45s', easing: 'cubic-bezier(0.65,0,0.35,1)', fillMode: 'both' }, new: { name: 'pbIn', duration: '0.7s', delay: '0.15s', easing: 'cubic-bezier(0.22,1,0.36,1)', fillMode: 'both' } },
  backwards: { old: { name: 'pbOut', duration: '0.45s', easing: 'cubic-bezier(0.65,0,0.35,1)', fillMode: 'both' }, new: { name: 'pbIn', duration: '0.7s', delay: '0.15s', easing: 'cubic-bezier(0.22,1,0.36,1)', fillMode: 'both' } },
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PropBillions" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#14281f" />
    <link rel="preload" as="font" type="font/woff2" href={serifFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={textFont} crossorigin />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    {preload.map((p) => <link rel="preload" as="image" href={u(p)} fetchpriority="high" />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
    <ClientRouter fallback="animate" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true" transition:persist="progress"><span data-progress></span></div>
    <Header tone={headerTone} />
    <nav class="rail" aria-label="On this page"><ol data-rail hidden></ol></nav>
    <main id="main" data-header-tone={headerTone} transition:animate={pageTurn}><slot /></main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
