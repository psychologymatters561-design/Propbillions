---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import site from '../data/site.json';
---
<Base title="Contact PropBillions: book a site visit" description="Book a site visit, ask for a shortlist or a Neev Check. Office in NX One, Tech Zone 4, Greater Noida West." breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }]}>
  <section class="section bp-grid"><div class="wrap two">
    <div>
      <p class="label">Contact</p>
      <h1 class="t">One small step.</h1>
      <p class="lede">A shortlist, a site visit or a Neev Check. Pick one; a person calls you back.</p>
      <dl class="c">
        <div><dt class="mono">Phone</dt><dd>{site.phones.map((p) => <a href={`tel:${p.replace(/\s/g, '')}`}>{p}</a>)}</dd></div>
        <div><dt class="mono">Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a><a href={`mailto:${site.salesEmail}`}>{site.salesEmail}</a></dd></div>
        <div><dt class="mono">Office</dt><dd>{site.address}</dd></div>
        <div><dt class="mono">Hours</dt><dd>{site.hours}</dd></div>
      </dl>
      <a class="btn btn--ghost" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('NX One Tech Zone 4 Greater Noida West')}`} rel="noopener" target="_blank">Directions</a>
    </div>
    <div id="visit"><span id="shortlist"></span><LeadForm intent="site-visit" id="contact-form" title="Book a site visit" /></div>
  </div></section>
</Base>
<style>
  .t { font-size: var(--step-5); }
  .two { display: grid; gap: var(--space-7); } @media (min-width: 960px) { .two { grid-template-columns: .9fr 1.1fr; } }
  .c { display: grid; gap: var(--space-4); margin: var(--space-6) 0; }
  .c div { border-top: 1px solid var(--lime-300); padding-top: var(--space-3); }
  .c dt { color: var(--ink-500); font-size: var(--step--1); }
  .c dd { margin: .3rem 0 0; display: grid; gap: .2rem; }
  .c a { min-height: 32px; display: inline-flex; align-items: center; }
</style>
