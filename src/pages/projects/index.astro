---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../lib/data';
const minPrice = (p: (typeof projects)[number]) => Math.min(...p.configs.map((c) => c.price ?? Infinity));
const band = (v: number) => (v === Infinity ? 'on-request' : v < 1e7 ? 'under-1cr' : v < 4e7 ? '1-4cr' : 'above-4cr');
const config = (p: (typeof projects)[number]) => (p.type !== 'Residential' ? 'commercial' : p.configs.map((c) => (c.type.match(/(\d) BHK/) || [])[1]).filter(Boolean).map((n) => `${n}bhk`).join(' '));
const status = (p: (typeof projects)[number]) => (/ready/i.test(p.status) ? 'ready' : /under/i.test(p.status) ? 'under-construction' : 'verify');
const cities = [...new Map(projects.map((p) => [p.city, p.cityLabel])).entries()];
---
<Base title="Projects in Noida, Greater Noida, South Delhi and Uttarakhand" description="Six projects with RERA status, all-in price estimates and what our checks found so far. Filter by city, budget, configuration, status and possession year." breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Projects', path: '/projects' }]}>
  <section class="section bp-grid">
    <div class="wrap">
      <p class="label">Projects</p>
      <h1 class="ttl">Six projects. <em>Read before listed.</em></h1>
      <p class="lede">Each card shows the RERA status, possession date and an all-in estimate where a price is published. If something is unknown, it says so.</p>
      <form class="filters" data-filters aria-label="Filter projects">
        <label>City<select name="city"><option value="">All</option>{cities.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
        <label>Budget<select name="budget"><option value="">Any</option><option value="under-1cr">Under ₹1 Cr</option><option value="1-4cr">₹1 to 4 Cr</option><option value="above-4cr">Above ₹4 Cr</option><option value="on-request">Price on request</option></select></label>
        <label>Configuration<select name="config"><option value="">Any</option><option value="1bhk">1 BHK</option><option value="2bhk">2 BHK</option><option value="3bhk">3 BHK</option><option value="4bhk">4 BHK</option><option value="5bhk">5 BHK</option><option value="commercial">Commercial</option></select></label>
        <label>Status<select name="status"><option value="">Any</option><option value="under-construction">Under construction</option><option value="ready">Ready to move</option><option value="verify">Stage to verify</option></select></label>
        <label>Possession year<select name="year"><option value="">Any</option><option value="none">Not published yet</option></select></label>
      </form>
      <p class="mono count" data-count-out aria-live="polite">{projects.length} projects</p>
      <div class="grid">
        {projects.map((p) => (
          <div data-item data-city={p.city} data-budget={band(minPrice(p))} data-config={config(p)} data-status={status(p)} data-year={p.possession ? 'some' : 'none'}>
            <ProjectCard p={p} />
          </div>
        ))}
      </div>
      <p class="empty" data-empty hidden>No project matches. <a href="#" data-reset>Clear filters</a>, or tell us what you need and we will look.</p>
    </div>
  </section>
</Base>
<style>
  .ttl em { color: var(--brass-600); }
  .filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-4); margin: var(--space-6) 0 var(--space-4); }
  .filters label { display: grid; gap: .3rem; font: 600 var(--step--1) var(--font-text); }
  .filters select { min-height: var(--tap); padding: .5rem; font: 400 16px var(--font-text); border: 1px solid var(--lime-300); border-radius: var(--radius); background: var(--lime-50); }
  .count { color: var(--ink-500); }
  .grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
</style>
<script>
  import { initXray } from '../../scripts/xray';
  initXray();
  const f = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const out = document.querySelector('[data-count-out]')!, empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const apply = () => {
    const v = Object.fromEntries(new FormData(f)) as Record<string, string>;
    let n = 0;
    for (const el of items) {
      const ok = (!v.city || el.dataset.city === v.city) && (!v.budget || el.dataset.budget === v.budget) && (!v.config || (el.dataset.config || '').split(' ').includes(v.config)) && (!v.status || el.dataset.status === v.status) && (!v.year || el.dataset.year === v.year);
      el.hidden = !ok; if (ok) n++;
    }
    out.textContent = `${n} project${n === 1 ? '' : 's'}`; empty.hidden = n > 0;
    const q = new URLSearchParams(Object.entries(v).filter(([, x]) => x)); history.replaceState(null, '', q.toString() ? `?${q}` : location.pathname);
  };
  new URLSearchParams(location.search).forEach((val, key) => { const el = f.elements.namedItem(key) as HTMLSelectElement | null; if (el) el.value = val; });
  f.addEventListener('change', apply); apply();
  document.querySelector('[data-reset]')!.addEventListener('click', (e) => { e.preventDefault(); f.reset(); apply(); });
</script>
