---
/** Schematic map. Positions from coordinates, roughly projected. Job: location truth, not decoration. */
import { projects, projectUrl } from '../lib/data';
import { u } from '../lib/url';
const P = (lat: number, lon: number) => [(lon - 77.0) * 400, (29.7 - lat) * 400];
const delhi = P(28.6139, 77.209);
const airport = P(28.17, 77.61);
const pins = projects.map((p) => ({ p, xy: P(p.coords[0], p.coords[1]) }));
const curve = (a: number[], b: number[], bend = 0.18) => {
  const mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2, dx = b[0] - a[0], dy = b[1] - a[1];
  return `M${a[0].toFixed(1)} ${a[1].toFixed(1)} Q${(mx - dy * bend).toFixed(1)} ${(my + dx * bend).toFixed(1)} ${b[0].toFixed(1)} ${b[1].toFixed(1)}`;
};
---
<figure class="map">
  <svg viewBox="0 60 1100 620" data-mapzoom data-from="0 60 1100 620" data-to="45 392 230 130" role="img" aria-label="Schematic map of PropBillions projects: five in Delhi NCR and one near Kainchi Dham in Uttarakhand">
    <rect x="-50" y="0" width="1200" height="800" fill="var(--forest-900)" />
    <g class="map__grid" stroke="rgb(134 174 230 / .08)" stroke-width=".6">
      {Array.from({ length: 23 }, (_, i) => <line x1={i * 50} y1="0" x2={i * 50} y2="800" />)}
      {Array.from({ length: 16 }, (_, i) => <line x1="-50" y1={i * 50} x2="1150" y2={i * 50} />)}
    </g>
    <path class="route route--long" d={curve(delhi, P(29.4237, 79.5168), -0.12)} />
    {pins.filter(({ p }) => p.state !== 'UK').map(({ xy }) => <path class="route" d={curve(delhi, xy)} />)}
    <path class="route route--air" d={curve(P(28.4648, 77.5103), airport, 0.1)} />
    <g class="map__city"><circle cx={delhi[0]} cy={delhi[1]} r="3" /><text class="far" x={delhi[0] - 8} y={delhi[1] - 10} text-anchor="end">Delhi NCR</text><text class="near" x={delhi[0] - 3} y={delhi[1] - 3} text-anchor="end">Delhi</text></g>
    <g class="map__air"><circle cx={airport[0]} cy={airport[1]} r="1.6" /><text class="near" x={airport[0] + 3} y={airport[1] + 1}>Noida International Airport</text></g>
    {pins.map(({ p, xy }) => (
      <a href={u(projectUrl(p))} class="map__pin">
        <circle cx={xy[0]} cy={xy[1]} r={p.state === 'UK' ? 6 : 2.2} />
        {p.state === 'UK'
          ? <text class="far" x={xy[0] + 12} y={xy[1] + 5}>{p.name}, Kainchi Dham</text>
          : <text class="near" x={xy[0] + 3} y={xy[1] - 2.5}>{p.name}</text>}
      </a>
    ))}
  </svg>
  <figcaption class="mono">Schematic. Positions approximate, not to scale for travel time. Lines show direction, not roads.</figcaption>
</figure>
<style>
  .map { margin: 0; }
  .map svg { width: 100%; height: auto; aspect-ratio: 1100 / 620; border-radius: var(--radius-lg); display: block; }
  .route { fill: none; stroke: var(--bp-300); stroke-width: 1; opacity: .8; }
  .route--long { stroke-dasharray: 6 6; stroke-width: 1.4; }
  .route--air { stroke: var(--lime-300); stroke-width: .6; stroke-dasharray: 2 2; }
  .map__city circle { fill: var(--lime-100); }
  .map__air circle { fill: var(--lime-300); }
  .map__pin circle { fill: var(--brass-300); stroke: var(--forest-900); stroke-width: .6; }
  .map__pin:hover circle, .map__pin:focus circle { fill: var(--lime-50); }
  text { font-family: var(--font-mono); fill: var(--lime-100); }
  .far { font-size: 18px; }
  .near { font-size: 4.2px; }
  figcaption { color: var(--forest-300); margin-top: .6rem; font-size: var(--step--1); }
</style>
